# NiftyRadar backend environment variables (names and purpose only, never real values).

# --- Existing (not changed by the paper bot) ---
DHAN_CLIENT_ID=            # Dhan client id (market data)
DHAN_ACCESS_TOKEN=         # Dhan API access token
DHAN_TOKEN_FILE=           # optional: where the renewed Dhan token is kept
RENEW_SECRET=              # key for /api/renew-token
PORT=                      # set by Render

# --- Paper-trading bot (demo only, no real orders) ---
PAPER_BOT_ENABLED=true     # "false" switches the whole bot off

# The bot's OWN Postgres database. NOT the PictoTrade / Neon database: the bot
# never reads DATABASE_URL. Any standard Postgres URL works, for example a free
# Supabase project (direct connection on port 5432, or the pooler). SSL is
# always used for a remote host, at most 2 connections, opened only when
# needed. Tables are created automatically on the first connect.
# Leave empty to keep paper trades in memory only (lost on restart; the
# Telegram summary is still sent).
PAPER_DATABASE_URL=

TELEGRAM_BOT_TOKEN=        # existing Telegram bot; summaries AND trade alerts (below) are sent here
TELEGRAM_CHAT_ID=          # chat that receives the summaries and trade alerts

# Telegram trade alerts (src/paper/ops/telegramAlerts/) - a message the MOMENT a trade is taken (entry
# price/target/stop with the level type in brackets, Rs lost if stop hit, Rs gained if target hit) and
# again when it closes. Needs TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID above. Covers every bot: nse, nse_scalp,
# crypto (intraday), crypto_scalp, crypto_wide_scalp, exhaustion_only, trend_smc. No end-of-day/summary text
# is ever sent by this feature - summaries above are separate and unaffected.
TELEGRAM_TRADE_ALERTS=     # "on" to enable entry (+ exit) alerts; anything else (including unset) = off
TELEGRAM_EXIT_ALERTS=      # "off" to silence the exit alert and keep only the entry one; default "on"
TELEGRAM_BOTS=             # optional comma list to alert for only these bots, e.g. "nse,crypto"; empty = all
USDINR_FALLBACK=           # optional USD->INR rate used only when a crypto trade's own fx_rate is missing; otherwise that trade's Rs estimate shows as USD with "rate n/a" (never an invented rate). Not used by nse/nse_scalp, which are already in rupees.
PAPER_JUDGE_ON=true        # "false" = the judge (docs/JUDGE.md) stops deciding NSE entries; the bot goes back to the plain pattern + trend rule
PAPER_SCALP_ENABLED=true   # "false" = no scalp strategy (docs/SCALP.md); the report /api/paper/scalp-report still shows what is stored
PAPER_CCY_USDINR_ENABLED=  # "false" = no USDINR currency-futures bot (NSE currency segment, reuses scalp_wide, free Yahoo FX feed). Same pattern for EURINR/GBPINR/JPYINR and each _MIRROR sibling (e.g. PAPER_CCY_USDINR_MIRROR_ENABLED); default on
PAPER_ADMIN_SECRET=        # key for the read-only /api/paper/trades, /skips, /summaries routes (falls back to RENEW_SECRET)
PAPER_NSE_MIRROR_ENABLED=  # "false" = no nse-MIRROR (opposite option, real Dhan price, own target/stop). Default on, follows PAPER_BOT_ENABLED
PAPER_NSE_REVERSE_ENABLED= # "false" = no nse-REVERSE (same side as nse-MIRROR, 2:1 reward:risk of its own). Default on, follows PAPER_BOT_ENABLED

# No new Dhan credential env vars were added for the token-renewal fix (2026-11): Dhan's public API has
# no documented from-scratch client-id+PIN+TOTP login endpoint (only GET /v2/RenewToken, which refreshes
# an ALREADY-valid token) - see the comment above cron.schedule(...renewDhanTokenWithRetry) in server.js.
# The renewal retry/alert logic reads only DHAN_CLIENT_ID/DHAN_ACCESS_TOKEN/DHAN_TOKEN_FILE above and
# TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID (for the one-per-day failure alert) - all already listed here.

# Keep-alive (Render free plan): point a free external pinger at
#   GET /api/paper/ping   every 5 minutes. It needs no key and no database.
